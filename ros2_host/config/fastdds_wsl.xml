<?xml version="1.0" encoding="UTF-8"?>
<dds xmlns="http://www.eprosima.com">
  <profiles>
    <!--
      WSL mirrored 网络会同时暴露多个虚拟接口。只允许 Fast DDS 使用
      PC 的局域网地址，避免向树莓派通告无法访问的虚拟网卡地址。
    -->
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>wsl_lan_udp</transport_id>
        <type>UDPv4</type>
        <!-- 覆盖树莓派上多个 ROS 进程可能使用的参与者端口。 -->
        <maxInitialPeersRange>32</maxInitialPeersRange>
        <interfaceWhiteList>
          <address>192.168.3.61</address>
        </interfaceWhiteList>
      </transport_descriptor>
    </transport_descriptors>

    <participant profile_name="wsl_lan_participant" is_default_profile="true">
      <rtps>
        <useBuiltinTransports>false</useBuiltinTransports>
        <userTransports>
          <transport_id>wsl_lan_udp</transport_id>
        </userTransports>
        <!-- 主动向树莓派发送单播发现报文，避免依赖 WSL 多播发现时延。 -->
        <builtin>
          <initialPeersList>
            <locator>
              <udpv4>
                <address>192.168.3.85</address>
              </udpv4>
            </locator>
          </initialPeersList>
        </builtin>
      </rtps>
    </participant>
  </profiles>
</dds>
